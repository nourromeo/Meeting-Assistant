<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Base button ── -->
    <Style x:Key="BaseBtn" TargetType="Button">
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="16,9"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.60"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Record ── -->
    <Style x:Key="RecordBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="18,10"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4757" Offset="0"/>
                    <GradientStop Color="#FF6B6B" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Pause (amber) ── -->
    <Style x:Key="PauseBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="{StaticResource PauseTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PauseBorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource PauseBrush}"/>
    </Style>

    <!-- ── Stop / neutral ── -->
    <Style x:Key="NeutralBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource SubtextBrush}"/>
    </Style>

    <!-- ── Upload (blue) ── -->
    <Style x:Key="UploadBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="{StaticResource Accent2TintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent2BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource Accent2Brush}"/>
    </Style>

    <!-- ── Summarize (teal gradient — primary action) ── -->
    <Style x:Key="SummarizeBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="24,10"/>
        <Setter Property="Foreground"      Value="#0A1F15"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00E5A0" Offset="0"/>
                    <GradientStop Color="#00C87A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Small panel button (Clear / Copy / Hide PII) ── -->
    <Style x:Key="PanelBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource MutedBrush}"/>
        <Setter Property="Padding"     Value="10,4"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="Normal"/>
    </Style>

    <!-- ── PII action button (off=red, on=green) ── -->
    <Style x:Key="PiiStateBtn" TargetType="Button" BasedOn="{StaticResource PanelBtn}">
        <Setter Property="Background"  Value="{StaticResource WarnTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource WarnBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Transcript.IsHidingPii}" Value="True">
                <Setter Property="Background"  Value="{StaticResource AccentTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Mode tab (ToggleButton) ── -->
    <Style x:Key="TabBtn" TargetType="ToggleButton">
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
