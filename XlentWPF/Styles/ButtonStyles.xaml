<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Base button ── -->
    <Style x:Key="BaseBtn" TargetType="Button">
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="16,9"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.60"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Record ── -->
    <Style x:Key="RecordBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="18,10"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4757" Offset="0"/>
                    <GradientStop Color="#FF6B6B" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Pause (amber) ── -->
    <Style x:Key="PauseBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="{StaticResource PauseTintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PauseBorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource PauseBrush}"/>
    </Style>

    <!-- ── Stop / neutral ── -->
    <Style x:Key="NeutralBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource SubtextBrush}"/>
    </Style>

    <!-- ── Upload (blue) ── -->
    <Style x:Key="UploadBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="{StaticResource Accent2TintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent2BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource Accent2Brush}"/>
    </Style>

    <!-- ── Summarize (teal gradient — primary action) ── -->
    <Style x:Key="SummarizeBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="24,10"/>
        <Setter Property="Foreground"      Value="#0A1F15"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00E5A0" Offset="0"/>
                    <GradientStop Color="#00C87A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Small panel button (Clear / Copy / Hide PII) ── -->
    <Style x:Key="PanelBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource MutedBrush}"/>
        <Setter Property="Padding"     Value="10,4"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="Normal"/>
    </Style>

    <!-- ── PII on/off toggle ── -->
    <Style x:Key="PiiToggleBtn" TargetType="ToggleButton">
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="Normal"/>
        <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="Padding"         Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Pill track -->
                            <Border x:Name="Track"
                                    Width="28" Height="15" CornerRadius="8"
                                    Background="#28FFFFFF" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <!-- Dot slides left (off) or right (on) -->
                                <Ellipse x:Name="Dot"
                                         Width="10" Height="10"
                                         Fill="#5A6080"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- ON state -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track"  Property="Background"         Value="#3300E5A0"/>
                            <Setter TargetName="Dot"    Property="Fill"               Value="#00E5A0"/>
                            <Setter TargetName="Dot"    Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Dot"    Property="Margin"              Value="0,0,2,0"/>
                            <Setter TargetName="Root"   Property="BorderBrush"         Value="{StaticResource AccentBorderBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Mode tab (ToggleButton) ── -->
    <Style x:Key="TabBtn" TargetType="ToggleButton">
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Foreground"      Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
