<UserControl x:Class="XlentWPF.Components.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="0,16,0,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── Wordmark ── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Logo -->
                <Image Source="pack://application:,,,/Asset/logo.png" Width="100"  Margin="0,0,8,0"/> 
                <TextBlock Text="Scribe"
                           FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Opacity="0.9"/>
            </StackPanel>

            <!-- ── Mode tabs ── -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="⚡  Live Meeting"
                                  Style="{StaticResource TabBtn}"
                                  IsChecked="{Binding Recording.IsLiveMode, Mode=OneWay}"
                                  Command="{Binding Recording.SwitchToLiveCommand}"/>
                    <ToggleButton Content="📁  Upload Audio"
                                  Style="{StaticResource TabBtn}"
                                  IsChecked="{Binding Recording.IsUploadMode, Mode=OneWay}"
                                  Command="{Binding Recording.SwitchToUploadCommand}"/>
                </StackPanel>
            </Border>

            <!-- ── Status + Timer ── -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right" >
                <!-- Status pill -->
                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="12,6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Recording.StatusDotColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Recording.StatusText}"
                                   Foreground="{StaticResource SubtextBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </StackPanel>
                </Border>
                <!-- Timer -->
                <TextBlock Text="{Binding Recording.TimerText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
