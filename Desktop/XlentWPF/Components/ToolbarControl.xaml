<UserControl x:Class="XlentWPF.Components.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XlentWPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Full-width toolbar card -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="10,8" Margin="0,14,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left: recording / upload controls -->
                <ColumnDefinition Width="Auto"/>
                <!-- Flexible space -->
                <ColumnDefinition Width="*"/>
                <!-- Center: primary action -->
                <ColumnDefinition Width="Auto"/>
                <!-- Flexible space -->
                <ColumnDefinition Width="*"/>
                <!-- Right: downloads -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Recording controls (Live mode) ── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Visibility="{Binding Recording.IsLiveMode, Converter={StaticResource BoolVis}}">
                <Button Content="⏺  Record"
                        Style="{StaticResource RecordBtn}"
                        Command="{Binding Recording.ToggleRecordCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="⏸  Pause"
                        Style="{StaticResource PauseBtn}"
                        Command="{Binding Recording.PauseCommand}"
                        IsEnabled="{Binding Recording.CanPause}"
                        Margin="0,0,6,0"/>
                <Button Content="⏹  Stop"
                        Style="{StaticResource NeutralBtn}"
                        Command="{Binding Recording.StopCommand}"
                        IsEnabled="{Binding Recording.CanStop}"/>
            </StackPanel>

            <!-- ── LEFT: Upload controls (Upload mode) ── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Visibility="{Binding Recording.IsUploadMode, Converter={StaticResource BoolVis}}">
                <Button Content="📤  Upload &amp; Transcribe"
                        Style="{StaticResource UploadBtn}"
                        Command="{Binding UploadFileCommand}"/>
            </StackPanel>

            <!-- ── CENTER: Summarize (primary action) ── -->
            <Button Grid.Column="2"
                    Content="✦  Summarize"
                    Style="{StaticResource SummarizeBtn}"
                    Command="{Binding SummarizeCommand}"
                    HorizontalAlignment="Center"/>

            <!-- ── RIGHT: Downloads ── -->
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="⬇  Transcript"
                        Style="{StaticResource NeutralBtn}"
                        Command="{Binding Transcript.DownloadCommand}"
                        Margin="0,0,6,0"/>
                <Button Content="⬇  Summary"
                        Style="{StaticResource NeutralBtn}"
                        Command="{Binding Summary.DownloadCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
