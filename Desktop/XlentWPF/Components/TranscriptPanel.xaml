<UserControl x:Class="XlentWPF.Components.TranscriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XlentWPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
            <conv:SpeakerIndexToBrushConverter     x:Key="SpeakerFg"/>
            <conv:SpeakerIndexToBackgroundConverter x:Key="SpeakerBg"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel header -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="#1A4F8EFF" Margin="0,0,8,0">
                            <TextBlock Text="📝" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="LIVE TRANSCRIPTION"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Style="{StaticResource PanelBtn}"
                                Command="{Binding Transcript.ClearCommand}" Margin="0,0,6,0"/>
                        <Button Content="Copy"  Style="{StaticResource PanelBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" Padding="16">
                <StackPanel>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,80,0,0"
                                Visibility="{Binding Transcript.Segments.Count,
                                    Converter={StaticResource InvBoolVis}}">
                        <TextBlock Text="🎙" FontSize="32" Opacity="0.4"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Press Record to start live transcription"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="or switch to Upload Audio mode"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Transcript segments -->
                    <ItemsControl ItemsSource="{Binding Transcript.Segments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Speaker + timestamp -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Border CornerRadius="10" Padding="7,2"
                                                    Background="{Binding SpeakerIndex,
                                                        Converter={StaticResource SpeakerBg}}">
                                                <TextBlock Text="{Binding SpeakerName}"
                                                           Foreground="{Binding SpeakerIndex,
                                                               Converter={StaticResource SpeakerFg}}"
                                                           FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                            <TextBlock Text="{Binding Timestamp}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Text -->
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   LineHeight="22"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
