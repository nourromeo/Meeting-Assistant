<UserControl x:Class="XlentWPF.Components.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,0,0,1"
        Padding="0,18,0,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00E5A0" Offset="0"/>
                            <GradientStop Color="#4F8EFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🎙" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
               FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="20">
        <Run Text="Meeting" Foreground="{StaticResource TextBrush}"/>
        <Run Text="Assistent"  Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>
            </StackPanel>

            <!-- Mode tabs -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Surface2Brush}"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="10" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="⚡ Live Meeting"
                        Style="{StaticResource TabBtn}"
                        IsChecked="{Binding Recording.IsLiveMode, Mode=OneWay}"
                        Command="{Binding Recording.SwitchToLiveCommand}"/>
                    <ToggleButton Content="📁 Upload Audio"
                        Style="{StaticResource TabBtn}"
                        IsChecked="{Binding Recording.IsUploadMode, Mode=OneWay}"
                        Command="{Binding Recording.SwitchToUploadCommand}"/>
                </StackPanel>
            </Border>

            <!-- Status + Timer -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="10,5" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Recording.StatusDotColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Recording.StatusText}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Recording.TimerText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>