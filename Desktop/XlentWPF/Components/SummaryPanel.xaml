<UserControl x:Class="XlentWPF.Components.SummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XlentWPF.Converters">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter     x:Key="BoolVis"/>
            <conv:NullToVisibilityConverter     x:Key="NullVis"/>
            <conv:NullToInvisibilityConverter   x:Key="NullInvVis"/>
        </ResourceDictionary>
    </UserControl.Resources>


    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel header -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="#1A00E5A0" Margin="0,0,8,0">
                            <TextBlock Text="✦" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AI SUMMARY"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Style="{StaticResource PanelBtn}"
                                Command="{Binding Summary.ClearCommand}" Margin="0,0,6,0"/>
                        <Button Content="Copy"  Style="{StaticResource PanelBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" Padding="16">
                <StackPanel>

                    <!-- Spinner -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,80,0,0"
                                Visibility="{Binding Summary.IsSummarizing, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="⟳" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.7" Margin="0,0,0,10"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="SpinnerRotate"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="Generating summary…"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty state (not summarizing AND no summary) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,80,0,0"
                                Visibility="{Binding Summary.Summary, Converter={StaticResource NullInvVis}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summary.IsSummarizing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="✦" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   Opacity="0.4" Margin="0,0,0,10"/>
                        <TextBlock Text="Click Summarize after transcription"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="to generate an AI-powered summary"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="Powered by GPT-4o mini + Azure AI"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" TextAlignment="Center"
                                   Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Summary content -->
                    <StackPanel Visibility="{Binding Summary.Summary, Converter={StaticResource NullVis}}">

                        <!-- Overview -->
                        <TextBlock Text="OVERVIEW"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="10"  Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Summary.Summary.Overview}"
                                   Foreground="{StaticResource SubtextBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   LineHeight="22" Margin="0,0,0,18"/>

                        <!-- Key Points -->
                        <TextBlock Text="KEY POINTS"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="10"  Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Summary.Summary.KeyPoints}" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="▸"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,2,8,0"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource SubtextBrush}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   LineHeight="20"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Action Items -->
                        <TextBlock Text="ACTION ITEMS"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   FontSize="10"  Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Summary.Summary.ActionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C00E5A0"
                                            BorderBrush="#1F00E5A0" BorderThickness="1"
                                            CornerRadius="7" Padding="10,7" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14"
                                                    BorderBrush="#6600E5A0" BorderThickness="1.5"
                                                    CornerRadius="3" Margin="0,1,8,0"/>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource SubtextBrush}"
                                                       FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
